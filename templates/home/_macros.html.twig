{# Badge de disponibilité : point vert animé si disponible, gris sinon #}
{% macro availability(profile, inverted = false) %}
    <div class="inline-flex items-center gap-2.5 self-start border px-3 py-1.5 text-[12px] font-semibold tracking-[.06em] uppercase {{ inverted ? 'border-white/70 text-white' : 'border-ink' }}">
        <span class="relative flex size-2.5 shrink-0" aria-hidden="true">
            {% if profile.available %}
                <span class="absolute inline-flex size-full animate-ping rounded-full {{ inverted ? 'bg-white' : 'bg-accent' }} opacity-60 motion-reduce:animate-none"></span>
                <span class="relative inline-flex size-2.5 rounded-full {{ inverted ? 'bg-white' : 'bg-accent' }}"></span>
            {% else %}
                <span class="relative inline-flex size-2.5 rounded-full {{ inverted ? 'bg-white/50' : 'bg-faint/60' }}"></span>
            {% endif %}
        </span>
        <span class="{{ profile.available or inverted ? '' : 'text-faint' }}">{{ profile.availabilityText }}</span>
    </div>
{% endmacro %}

{# Lien mailto avec un objet prérempli #}
{% macro mailto(profile) -%}
    mailto:{{ profile.email }}?subject={{ ('Prise de contact via ' ~ app.request.host)|url_encode }}
{%- endmacro %}

{# Grille de cartes projets (pro et freelance) #}
{% macro project_grid(projects) %}
    {% set uploads = 'uploads/images/' %}
    <div class="grid grid-cols-[repeat(auto-fill,minmax(min(100%,300px),1fr))] gap-4">
        {% for project in projects %}
            {% set tag = project.url ? 'a' : 'article' %}
            <{{ tag }} {% if project.url %}href="{{ project.url }}" target="_blank" rel="noopener" {% endif %}class="flex flex-col gap-3 border border-ink p-4{{ project.url ? ' hover:bg-hover' }}">
                {% if project.image %}
                    <img src="{{ asset(uploads ~ project.image) }}" alt="{{ project.title }}" class="aspect-[16/10] w-full object-cover" loading="lazy">
                {% else %}
                    <div class="image-placeholder aspect-[16/10] w-full">visuel {{ project.title }}</div>
                {% endif %}
                <div class="flex flex-col gap-1">
                    <h3 class="m-0 text-[18px] font-semibold tracking-[-.01em]">{{ project.title }}{% if project.url %} ↗{% endif %}</h3>
                    {% if project.client %}<div class="text-[13px] font-medium text-accent">{{ project.client }}</div>{% endif %}
                    {% if project.description %}<p class="mt-1 mb-0 text-[14px] leading-[1.5] text-muted">{{ project.description }}</p>{% endif %}
                </div>
                {% if project.technologies is not empty %}
                <div class="mt-auto flex flex-wrap gap-1.5">
                    {% for techno in project.technologies %}<span class="tag-sm">{{ techno }}</span>{% endfor %}
                </div>
                {% endif %}
            </{{ tag }}>
        {% endfor %}
    </div>
{% endmacro %}
